# CORS origins allowed to call the API (dev + vite)
CORS_ORIGIN=http://localhost:5173

# Public base URL used to build webhook callback URLs (e.g. https://anika.org)
PUBLIC_BASE_URL=

# WhatsApp Business Cloud API (optional — hooks disabled while unset)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=anika_verify
WHATSAPP_BASE_URL=https://graph.facebook.com/v19.0

# M-Pesa Daraja (optional — sandbox values from the Safaricom developer portal)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
# Public callback URL for Daraja to reach this server (or leave empty to auto-build from PUBLIC_BASE_URL)
MPESA_STK_CALLBACK_URL=